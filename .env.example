# ─────────────────────────────────────────────────────────
# Project 1 — Geospatial Document Intelligence
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────

# Get a free key at https://console.groq.com
GROQ_API_KEY=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

# HuggingFace token (optional but recommended)
# Avoids rate-limiting on model downloads from huggingface.co
# Get at: https://huggingface.co/settings/tokens  (read-only token is enough)
HUGGINGFACE_HUB_TOKEN=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

# Model to use — llama3-8b-8192 is decommissioned (mid-2025)
# Recommended options (free tier):
#   llama-3.3-70b-versatile  — best quality, great for technical documents
#   llama-3.1-8b-instant     — faster, lower latency
GROQ_MODEL=llama-3.3-70b-versatile

# Embedding model (runs locally, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB persistence directory (relative to project root)
CHROMA_PERSIST_DIR=./data/chroma_db

# Docs folder (relative to project root)
DOCS_DIR=./docs

# Testset output path
TESTSET_PATH=./data/testset.json

# Chunk settings
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=5
